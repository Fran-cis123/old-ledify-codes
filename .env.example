PORT=5000
MONGO_URL=mongodb://127.0.0.1:27017/ledify
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Optional server tuning (defaults shown).
LEDIFY_SLIDE_CONCURRENCY=4
LEDIFY_DOCUMENT_CONCURRENCY=3
LEDIFY_URL_MAX_MB=10

# Install LibreOffice and Poppler for presentation PDF/PNG output.
# Set executable paths if they are not discoverable on this machine.
# LIBREOFFICE_PATH=/usr/bin/libreoffice
# PDFTOPPM_PATH=/usr/bin/pdftoppm
