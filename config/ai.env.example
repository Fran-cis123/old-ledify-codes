# Copy values into the server's secret environment. Never commit real keys.
AI_TEXT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_MAX_OUTPUT_TOKENS=16384
CLAUDE_EFFORT=medium

# Keep disabled until separate image-provider approval and credentials exist.
AI_IMAGE_PROVIDER=disabled
AI_IMAGE_PROVIDER_APPROVED=false
AI_IMAGE_MODEL=
AI_IMAGE_API_KEY=
AI_IMAGE_ESTIMATED_UNIT_COST=0.06
AI_IMAGE_MAX_ESTIMATED_COST=0.18
PRESENTATION_ALLOW_IMAGE_GENERATION=false
WEBPAGE_ALLOW_IMAGE_GENERATION=false
DOCUMENT_ALLOW_IMAGE_GENERATION=false

LEDIFY_GENERATION_CONCURRENCY=2
LEDIFY_AI_CONCURRENCY=6
LEDIFY_SLIDE_CONCURRENCY=6
LEDIFY_RENDER_CONCURRENCY=1

# Disabled rollback only. Selecting this requires an explicit operator action;
# Anthropic or dedicated-image failures never activate it automatically.
AI_ALLOW_GOOGLE_ROLLBACK=false
